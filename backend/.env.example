```env
# ============================================
# MongoDB Database
# ============================================
# MongoDB connection string
MONGO_URI=your_mongodb_connection_string

# ============================================
# Server Configuration
# ============================================
# Backend server port
PORT=5001

# Application environment (development/production)
NODE_ENV=development

# ============================================
# Authentication
# ============================================
# Secret key used for JWT token generation
JWT_SECRET=your_jwt_secret

# Secret key used for password reset token generation
RESET_PASSWORD_SECRET=your_reset_password_secret

# ============================================
# Resend Email Service
# ============================================
# API key from https://resend.com
RESEND_API_KEY=your_resend_api_key

# ============================================
# Cloudinary
# ============================================
# Cloudinary cloud name
CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
API_KEY=your_cloudinary_api_key

# Cloudinary API secret
API_SECRET=your_cloudinary_api_secret

# ============================================
# Frontend URL
# ============================================
# URL of your frontend application
FRONTEND_URL=http://localhost:5173

# ============================================
# Redis
# ============================================
# Redis connection URL (Local or Upstash)
REDIS_URL=your_redis_url

# ============================================
# API Monitoring Service
# ============================================
# Production monitoring API URL
APIMONITORING_URL=https://your-monitoring-api-url.com

# Local monitoring API URL
APILOCALHOST_MONITORING=http://localhost:8080
```
