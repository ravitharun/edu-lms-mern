                <mxCell id="37" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;If theres is No Cache Based on the request it will get the data from the database and Store in the Cache for the next request&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;rotation=0;" vertex="1" parent="1">
