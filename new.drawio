                <mxCell id="35" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;If theres is any Cache Based on the request it will check in the Cache and get the data&amp;nbsp; based on the request&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;rotation=0;" vertex="1" parent="1">
